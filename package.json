{
  "name": "rebound-ai",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "check:rls": "pnpm --filter @rebound/db check:rls",
    "db:generate": "pnpm --filter @rebound/db generate",
    "db:push": "pnpm --filter @rebound/db push",
    "db:studio": "pnpm --filter @rebound/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
