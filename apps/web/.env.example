# Supabase Postgres — beta project (System Design > Environments: separate from production)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rebound?schema=public"

# RLS-restricted role used by tRPC's protectedProcedure/adminProcedure (see
# packages/db/scripts/setup-rls-role.ts and packages/db/sql/rls-policies.sql).
# NOT the same credentials as DATABASE_URL above.
DATABASE_URL_RLS="postgresql://rebound_app:[ROLE-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Clerk (Auth & Permissions)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Anthropic API — Flow A / Flow B regime generation and adjustment (Sonnet 5 per Tech Stack)
ANTHROPIC_API_KEY="sk-ant-..."

# Vercel Cron auth — Vercel sends this as a Bearer token on scheduled invocations
CRON_SECRET="a-long-random-secret"
