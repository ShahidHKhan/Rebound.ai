{
  "openapi": "3.0.0",
  "info": {
    "title": "Rebound.ai API",
    "version": "1.0.0",
    "description": "Generated from packages/contracts/src/schemas/**. Do not hand-edit — run `pnpm --filter @rebound/contracts generate` after changing a schema."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-21T12:00:00.000Z"
          }
        },
        "required": [
          "ok",
          "timestamp"
        ]
      },
      "ExerciseMedia": {
        "type": "object",
        "nullable": true,
        "properties": {
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Exercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "MOBILITY",
              "STRENGTH",
              "STRETCH"
            ]
          },
          "targetMuscleGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficultyLevel": {
            "type": "integer"
          },
          "equipment": {
            "type": "string",
            "nullable": true,
            "enum": [
              "BODY_ONLY",
              "MACHINE",
              "OTHER",
              "FOAM_ROLL",
              "KETTLEBELLS",
              "DUMBBELL",
              "CABLE",
              "BARBELL",
              "BANDS",
              "MEDICINE_BALL",
              "EXERCISE_BALL",
              "EZ_CURL_BAR"
            ]
          },
          "contraindications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "progressionGroup": {
            "type": "string",
            "nullable": true
          },
          "media": {
            "$ref": "#/components/schemas/ExerciseMedia"
          },
          "source": {
            "type": "string"
          },
          "externalId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "targetMuscleGroups",
          "difficultyLevel",
          "equipment",
          "contraindications",
          "progressionGroup",
          "media",
          "source",
          "externalId"
        ]
      },
      "GetMeResponse": {
        "type": "object",
        "properties": {
          "goalType": {
            "type": "string",
            "enum": [
              "INJURY_RECOVERY",
              "STRENGTH",
              "MOBILITY",
              "GENERAL_FITNESS"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "wakeTimeMinutes": {
            "type": "integer",
            "nullable": true
          },
          "eveningTimeMinutes": {
            "type": "integer",
            "nullable": true
          },
          "billing": {
            "type": "object",
            "properties": {
              "trialActive": {
                "type": "boolean"
              },
              "firstAdjustmentAt": {
                "type": "string",
                "nullable": true,
                "format": "date-time"
              }
            },
            "required": [
              "trialActive",
              "firstAdjustmentAt"
            ]
          }
        },
        "required": [
          "goalType",
          "createdAt",
          "wakeTimeMinutes",
          "eveningTimeMinutes",
          "billing"
        ]
      },
      "SubmitCancellationFeedbackResponse": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "received"
        ]
      },
      "NotificationTimes": {
        "type": "object",
        "properties": {
          "wakeTimeMinutes": {
            "type": "integer",
            "nullable": true
          },
          "eveningTimeMinutes": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "wakeTimeMinutes",
          "eveningTimeMinutes"
        ]
      },
      "DeleteMyAccountResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "success"
        ]
      },
      "OnboardingSubmitCrisisResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "crisis_detected"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "reasons"
        ]
      },
      "OnboardingSubmitRedFlaggedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "red_flagged"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "reasons"
        ]
      },
      "OnboardingSubmitCooldownResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cooldown_active"
            ]
          },
          "regimeCreatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "regimeCreatedAt"
        ]
      },
      "OnboardingSubmitJobCreatedResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "job_created"
            ]
          },
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "jobId"
        ]
      },
      "OnboardingJobStatusResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETE",
              "FAILED"
            ]
          },
          "resultRegimeId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "resultRegimeId",
          "createdAt",
          "completedAt"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check — no auth required",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/exercises/{exerciseId}": {
      "get": {
        "tags": [
          "exercise"
        ],
        "summary": "Get a single exercise-library entry by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "exerciseId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Exercise found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exercise"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "No exercise with this id"
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Get the current user's profile + billing status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "delete": {
        "tags": [
          "user"
        ],
        "summary": "Permanently delete the current user's account and app data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteMyAccountResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/users/me/cancellation-feedback": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Record a cancellation reason (beta preview — no real subscription exists yet)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reasonCode": {
                    "type": "string",
                    "enum": [
                      "TOO_EXPENSIVE",
                      "NOT_SEEING_RESULTS",
                      "PLAN_TOO_DEMANDING",
                      "PLAN_TOO_EASY",
                      "TECHNICAL_ISSUES",
                      "OTHER"
                    ]
                  },
                  "comment": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "reasonCode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitCancellationFeedbackResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/users/me/notification-times": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Get the current user's wake / evening session times",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationTimes"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "patch": {
        "tags": [
          "user"
        ],
        "summary": "Update the current user's wake / evening session times",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wakeTimeMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439
                  },
                  "eveningTimeMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439
                  }
                },
                "required": [
                  "wakeTimeMinutes",
                  "eveningTimeMinutes"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationTimes"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/onboarding": {
      "post": {
        "tags": [
          "onboarding"
        ],
        "summary": "Submit onboarding answers — screens for crisis/red-flag/cooldown, else kicks off async regime generation",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answers": {
                    "type": "object",
                    "properties": {
                      "age": {
                        "type": "integer",
                        "minimum": 13,
                        "maximum": 120
                      },
                      "goalType": {
                        "type": "string",
                        "enum": [
                          "INJURY_RECOVERY",
                          "STRENGTH",
                          "MOBILITY",
                          "GENERAL_FITNESS"
                        ]
                      },
                      "conditionFlags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "injurySeverity": {
                        "type": "string",
                        "enum": [
                          "none",
                          "mild",
                          "moderate",
                          "severe"
                        ]
                      },
                      "redFlags": {
                        "type": "object",
                        "properties": {
                          "severeSuddenPain": {
                            "type": "boolean"
                          },
                          "numbnessOrTingling": {
                            "type": "boolean"
                          },
                          "recentTrauma": {
                            "type": "boolean"
                          },
                          "recentSurgery": {
                            "type": "boolean"
                          },
                          "pregnancyRelated": {
                            "type": "boolean"
                          },
                          "cardiacSymptomsWithExertion": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "severeSuddenPain",
                          "numbnessOrTingling",
                          "recentTrauma",
                          "recentSurgery",
                          "pregnancyRelated",
                          "cardiacSymptomsWithExertion"
                        ]
                      }
                    },
                    "required": [
                      "age",
                      "goalType",
                      "conditionFlags",
                      "injurySeverity",
                      "redFlags"
                    ]
                  },
                  "targetMovement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "symptomsText": {
                    "type": "string",
                    "maxLength": 750
                  },
                  "lifestyleContextText": {
                    "type": "string",
                    "maxLength": 750
                  },
                  "wakeTimeMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439
                  },
                  "eveningTimeMinutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1439
                  },
                  "availableEquipment": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "BODY_ONLY",
                        "MACHINE",
                        "OTHER",
                        "FOAM_ROLL",
                        "KETTLEBELLS",
                        "DUMBBELL",
                        "CABLE",
                        "BARBELL",
                        "BANDS",
                        "MEDICINE_BALL",
                        "EXERCISE_BALL",
                        "EZ_CURL_BAR"
                      ]
                    }
                  }
                },
                "required": [
                  "answers",
                  "targetMovement",
                  "symptomsText",
                  "lifestyleContextText"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Always 200 — all four outcomes (crisis_detected/red_flagged/cooldown_active/job_created) are successful screening results, not errors.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OnboardingSubmitCrisisResponse"
                    },
                    {
                      "$ref": "#/components/schemas/OnboardingSubmitRedFlaggedResponse"
                    },
                    {
                      "$ref": "#/components/schemas/OnboardingSubmitCooldownResponse"
                    },
                    {
                      "$ref": "#/components/schemas/OnboardingSubmitJobCreatedResponse"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "crisis_detected": "#/components/schemas/OnboardingSubmitCrisisResponse",
                      "red_flagged": "#/components/schemas/OnboardingSubmitRedFlaggedResponse",
                      "cooldown_active": "#/components/schemas/OnboardingSubmitCooldownResponse",
                      "job_created": "#/components/schemas/OnboardingSubmitJobCreatedResponse"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/onboarding/jobs/{jobId}": {
      "get": {
        "tags": [
          "onboarding"
        ],
        "summary": "Poll a regime-generation job's status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "jobId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingJobStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "Job belongs to another user"
          }
        }
      }
    }
  }
}
