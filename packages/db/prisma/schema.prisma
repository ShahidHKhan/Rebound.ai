generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum GoalType {
  INJURY_RECOVERY
  STRENGTH
  MOBILITY
  GENERAL_FITNESS
}

// Drives the change-ceiling table in Clinical Risk Framing > Regime Generation Architecture.
enum RiskTier {
  GENERAL
  LIGHT_INJURY
  HEAVIER_CHRONIC_ELDERLY
}

enum UserRole {
  USER
  ADMIN
}

enum SignupCohort {
  BETA
  PROD
}

enum ExerciseCategory {
  MOBILITY
  STRENGTH
  STRETCH
}

enum SessionSlot {
  MORNING
  EVENING
}

enum RegimeCreatedBy {
  AGENT
  USER_EDITED
  // LLM Reliability & Failure Handling: assigned from a Preset when Flow A
  // exhausts its retries — distinguishes a fallback regime from a genuine
  // LLM draft in the audit trail.
  PRESET_FALLBACK
}

// Free Exercise DB's own equipment taxonomy (confirmed against the live
// source data 2026-08-20 — 13 distinct values including null). Previously
// silently dropped by seed-exercises.ts; now captured so exercises can be
// filtered to what a user actually has access to.
enum Equipment {
  BODY_ONLY
  MACHINE
  OTHER
  FOAM_ROLL
  KETTLEBELLS
  DUMBBELL
  CABLE
  BARBELL
  BANDS
  MEDICINE_BALL
  EXERCISE_BALL
  EZ_CURL_BAR
}

enum PresetKind {
  // Existing conservative presets — assignFallbackPreset's zero-LLM path.
  FALLBACK
  // A slotted protocol shape Flow A retrieves and fills. Has PresetSlot rows
  // instead of PresetExercise rows.
  SKELETON
}

enum RegimeStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ENDED
}

enum TriggerType {
  SCHEDULED_ADJUSTMENT
  ESCALATION_ROLLBACK
}

enum JobStatus {
  PENDING
  COMPLETE
  FAILED
}

// ── Admin experimentation dashboard ─────────────────────────────────────

enum LlmFlow {
  FLOW_A_DRAFT
  FLOW_B_ADJUST
  FREE_TEXT_CLASSIFIER
}

enum LlmCallSource {
  PRODUCTION
  ADMIN_TEST
}

enum TestFixtureType {
  ONBOARDING
  ADJUSTMENT
}

enum TestRunStatus {
  RUNNING
  VALID
  INVALID
  ERROR
}

enum SyntheticPainPattern {
  IMPROVING
  PLATEAUING
  WORSENING
  CONTRADICTORY
}

// ── User ─────────────────────────────────────────────────────────────────

model User {
  // Clerk's user id is used directly as the primary key so no separate
  // identity-mapping table is needed between auth and app data.
  id        String   @id
  createdAt DateTime @default(now())

  goalType  GoalType
  riskTier  RiskTier
  // e.g. autoimmune, post_surgical, chronic
  conditionFlags String[]
  // Schema stores an array for forward compatibility; v1 enforces a single
  // primary movement at the UI/API layer (Data Model note, Open Question #10).
  targetMovements String[]

  role         UserRole     @default(USER)
  signupCohort SignupCohort @default(BETA)

  // Daily Session Structure: morning session "on wake", evening session at a
  // user-picked time. Both nullable/optional at onboarding — regime.activate
  // falls back to the original 7am/6pm placeholders when unset. Minutes
  // since local midnight (e.g. 420 = 07:00).
  wakeTimeMinutes    Int?
  eveningTimeMinutes Int?

  // Equipment the user has access to at home, captured at onboarding.
  // Empty (the default) means bodyweight-only — exercises with equipment
  // BODY_ONLY or no equipment recorded are always eligible regardless of
  // this list; see searchExercises in packages/agents.
  availableEquipment Equipment[]

  // Set from the admin panel; checked by both the escalation monitor and
  // Flow B before either takes action on this user.
  manualHold       Boolean @default(false)
  manualHoldReason String?

  regimes               Regime[]
  workoutSessions       WorkoutSession[]
  sessionLogs           SessionLog[]
  adjustmentEvents      AdjustmentEvent[]
  regimeGenerationJobs  RegimeGenerationJob[]

  @@map("users")
}

// ── Exercise library ────────────────────────────────────────────────────

model Exercise {
  id       String            @id @default(cuid())
  name     String
  category ExerciseCategory

  targetMuscleGroups String[]
  difficultyLevel    Int
  // Null means Free Exercise DB recorded no equipment for this entry
  // (distinct from BODY_ONLY, which is an explicit "no equipment needed").
  equipment          Equipment?
  // No PT-annotated contraindications in v1 (Free Exercise DB has none) —
  // field exists for the deferred PT-annotated content phase.
  contraindications  String[]
  // Links easier/harder variants of the same movement.
  progressionGroup   String?
  media              Json?
  source             String

  // Free Exercise DB slug, kept for idempotent re-seeding.
  externalId String? @unique

  regimeExercises RegimeExercise[]
  presetExercises PresetExercise[]

  @@map("exercises")
}

// ── Regime (versioned) ──────────────────────────────────────────────────

model Regime {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  versionNumber Int
  createdAt     DateTime        @default(now())
  createdBy     RegimeCreatedBy

  status    RegimeStatus @default(ACTIVE)
  endReason String?

  // Set when Flow A builds this regime from a skeleton Preset (kind:
  // SKELETON) rather than the old fully-freeform path — lets the review UI
  // show which protocol shape and literature citation backed this regime.
  // Null for freeform-generated, USER_EDITED, or PRESET_FALLBACK regimes.
  sourcePresetId String?
  sourcePreset   Preset? @relation(fields: [sourcePresetId], references: [id])

  parentRegimeId String?
  parentRegime   Regime?  @relation("RegimeHistory", fields: [parentRegimeId], references: [id])
  childRegimes   Regime[] @relation("RegimeHistory")

  exerciseList RegimeExercise[]

  workoutSessions     WorkoutSession[]
  sessionLogs         SessionLog[]
  adjustmentEventsFrom AdjustmentEvent[] @relation("AdjustmentFromRegime")
  adjustmentEventsTo   AdjustmentEvent[] @relation("AdjustmentToRegime")
  regimeGenerationJobs RegimeGenerationJob[]

  @@unique([userId, versionNumber])
  @@map("regimes")
}

// Join table: one row per exercise placed in a regime, carrying the
// prescription (sets/reps/duration/frequency) and its morning/evening slot.
model RegimeExercise {
  id         String @id @default(cuid())
  regimeId   String
  regime     Regime @relation(fields: [regimeId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  sets            Int?
  reps            Int?
  durationSeconds Int?
  frequency       String?
  sessionSlot     SessionSlot
  orderIndex      Int

  @@map("regime_exercises")
}

// ── Presets ──────────────────────────────────────────────────────────────
// Independent of a user's personalized regime; also the fallback destination
// when Flow A fails to produce a valid regime (LLM Reliability & Failure Handling).

model Preset {
  id          String     @id @default(cuid())
  name        String
  description String?
  riskTier    RiskTier?
  createdAt   DateTime   @default(now())

  // Distinguishes a concrete fallback regime from a slotted skeleton sharing
  // the same riskTier value — see PresetKind above.
  kind PresetKind @default(FALLBACK)

  // Skeleton retrieval keys. goalType narrows by intent (injury recovery vs.
  // general fitness); bodyRegionTags is keyword-matched against the user's
  // free-text targetMovement/conditionFlags (targetMovement is unconstrained
  // free text, not an enum, so this can't be a structured foreign key).
  goalType       GoalType?
  bodyRegionTags String[]

  exerciseList         PresetExercise[]
  slots                PresetSlot[]
  regimeGenerationJobs RegimeGenerationJob[]
  regimes              Regime[]

  @@map("presets")
}

model PresetExercise {
  id         String   @id @default(cuid())
  presetId   String
  preset     Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  sets            Int?
  reps            Int?
  durationSeconds Int?
  frequency       String?
  sessionSlot     SessionSlot
  orderIndex      Int

  @@map("preset_exercises")
}

model PresetSlot {
  id       String @id @default(cuid())
  presetId String
  preset   Preset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  sessionSlot SessionSlot
  orderIndex  Int
  // Short human-readable intent, e.g. "Primary shoulder mobility drill" —
  // shown to the LLM alongside the narrowed search_exercises candidates so
  // it knows what the slot is for, not just its filter constraints.
  label String

  // Constraints search_exercises gets scoped to when filling this slot.
  exerciseCategory ExerciseCategory?
  muscleGroupTags  String[]
  maxDifficulty    Int?

  // Suggested dosing — the LLM personalizes within these, doesn't invent
  // from scratch. Same optional-field shape as PresetExercise.
  suggestedSets            Int?
  suggestedReps            Int?
  suggestedDurationSeconds Int?
  suggestedFrequency       String?

  // Literature grounding for why this slot exists — audit trail back to a
  // named source, not just "the LLM said so."
  rationale String?

  @@map("preset_slots")
}

// ── Workout Session ──────────────────────────────────────────────────────
// One per scheduled morning/evening slot per day. Distinct from SessionLog:
// this tracks exercise completion (what streaks are computed from);
// SessionLog tracks self-reported stats.

model WorkoutSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  regimeVersionId String
  regime          Regime   @relation(fields: [regimeVersionId], references: [id])
  date           DateTime @db.Date

  slot         SessionSlot
  scheduledAt  DateTime
  completedAt  DateTime?

  exercisesCompleted WorkoutSessionExercise[]

  @@unique([userId, date, slot])
  @@map("workout_sessions")
}

model WorkoutSessionExercise {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  completed        Boolean        @default(false)

  @@map("workout_session_exercises")
}

// ── Session Log ──────────────────────────────────────────────────────────
// One per day — the daily stat/pain check-in, bundled with the morning session.

model SessionLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  regimeVersionId String
  regime          Regime   @relation(fields: [regimeVersionId], references: [id])
  loggedAt        DateTime @default(now())

  painScore Int
  // Flexible/typed field per goal_type (e.g. ROM degrees, rep max, RPE-based strength).
  mobilityStrengthIndicator Json?
  completed         Boolean @default(true)
  perceivedExertion Int?
  // "This made it worse" — feeds the adverse-event guardrail metric and the escalation monitor.
  flag Boolean @default(false)

  @@unique([userId, loggedAt])
  @@map("session_logs")
}

// ── Adjustment Event ─────────────────────────────────────────────────────
// Audit trail for the agent; also backs the reversal-rate guardrail metric.

model AdjustmentEvent {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  fromRegimeVersionId String
  fromRegime          Regime      @relation("AdjustmentFromRegime", fields: [fromRegimeVersionId], references: [id])
  toRegimeVersionId   String
  toRegime            Regime      @relation("AdjustmentToRegime", fields: [toRegimeVersionId], references: [id])
  triggeredAt      DateTime    @default(now())

  triggerType        TriggerType
  // Days of Session Log history used — confirms only 1-2 weeks of data used.
  trailingWindowUsed Int
  // Agent's stated reason, stored even if not user-facing; also carries
  // system-level causes (e.g. "held due to API outage").
  rationale          String
  // Set retroactively — this is the reversal-rate guardrail metric as a first-class field.
  wasReversed        Boolean     @default(false)

  @@map("adjustment_events")
}

// ── Regime Generation Job ────────────────────────────────────────────────
// Backs Flow A's async-job + polling architecture (System Design > v1 Beta).

model RegimeGenerationJob {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  status   JobStatus @default(PENDING)
  retryCount Int     @default(0)
  createdAt  DateTime @default(now())
  completedAt DateTime?

  resultRegimeId String?
  resultRegime   Regime? @relation(fields: [resultRegimeId], references: [id])

  fallbackPresetId String?
  fallbackPreset   Preset? @relation(fields: [fallbackPresetId], references: [id])

  error String?

  @@map("regime_generation_jobs")
}

// ── Admin experimentation dashboard ─────────────────────────────────────
// Not user-owned data (same category as Exercise/Preset) — deliberately no
// RLS policy for any of these three, see packages/db/sql/rls-policies.sql.

// One row per actual Anthropic API call — each tool-use round-trip within a
// single flow invocation is its own row. Real traffic and admin test runs
// both write here, distinguished by `source`. Written by the privileged
// connection only (packages/agents), never by prismaRls.
model LlmCall {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  flow          LlmFlow
  source        LlmCallSource
  model         String
  // Correlates every call belonging to one flow invocation (one onboarding
  // draft, one Flow B adjustment, one admin test run) so a trace view can
  // group and order them — not a hard FK, just a shared generated id.
  groupId       String
  sequenceIndex Int

  userId    String? // set for PRODUCTION calls, null for ADMIN_TEST
  testRunId String?
  testRun   TestRun? @relation(fields: [testRunId], references: [id], onDelete: Cascade)

  inputTokens  Int
  outputTokens Int
  latencyMs    Int
  costUsd      Decimal? @db.Decimal(10, 6)
  stopReason   String?
  success      Boolean
  errorMessage String?

  // Full request (messages/tools sent) and response (content blocks
  // returned) for trace inspection.
  requestJson  Json
  responseJson Json?

  @@index([groupId])
  @@index([flow, source, createdAt])
  @@map("llm_calls")
}

// A saved synthetic input for dry-running a flow — never references a real
// User row. ONBOARDING payloads match onboardingSubmissionSchema exactly;
// ADJUSTMENT payloads match adjustmentFixtureSchema (packages/api/src/schemas.ts).
model TestFixture {
  id          String          @id @default(cuid())
  name        String
  description String?
  type        TestFixtureType
  payload     Json
  createdAt   DateTime        @default(now())

  testRuns TestRun[]

  @@map("test_fixtures")
}

// One admin-triggered dry run of a flow against a fixture + chosen model, OR
// one cycle within a Scenario chain (see below). Never writes to
// User/Regime/AdjustmentEvent — that's the isolation guarantee that keeps
// this feature from touching real production data.
model TestRun {
  id        String        @id @default(cuid())
  // Null for a scenario cycle beyond cycle 0 — its input is generated on the
  // fly, not read from a saved TestFixture.
  fixtureId String?
  fixture   TestFixture?  @relation(fields: [fixtureId], references: [id])
  flow      LlmFlow
  model     String
  status    TestRunStatus @default(RUNNING)
  // Drafted/proposed regime + validation issues + (for Flow B) decision/rationale.
  // Null while status is RUNNING; set when the run finishes (or errors).
  resultJson      Json?
  createdByUserId String
  createdAt       DateTime @default(now())

  // Set only for a Scenario cycle (see Scenario below): scenarioId + cycleIndex
  // (0 = Flow A, 1..N = successive Flow B cycles) link this run into a chain.
  // inputJson carries exactly what was fed into this cycle — the onboarding
  // payload at cycle 0, or {painPattern, days, trailingSessionLogs} at cycle
  // 1+ — so history can be reconstructed without re-deriving anything.
  scenarioId String?
  scenario   Scenario? @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  cycleIndex Int?
  inputJson  Json?

  llmCalls LlmCall[]

  @@index([scenarioId, cycleIndex])
  @@map("test_runs")
}

// A synthetic Flow A -> Flow B -> Flow B... chain, for watching a regime
// evolve over several simulated adjustment cycles without needing weeks of
// real usage to accumulate first. Not user-owned data — same no-RLS
// treatment as LlmCall/TestFixture/TestRun above.
model Scenario {
  id              String   @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime @default(now())
  createdByUserId String

  testRuns TestRun[]

  @@map("scenarios")
}
