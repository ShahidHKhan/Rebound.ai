# Supabase Postgres connection string (used by `prisma generate` / `prisma db push` / `prisma studio`).
# Use the pooled connection string (Settings > Database > Connection pooling), not the direct one —
# Supabase's direct connection has a low max-connections limit that serverless (Vercel) traffic can
# exhaust quickly. The username is "postgres.<project-ref>", not bare "postgres" — that's the
# pooler-specific format (see packages/db/scripts/setup-rls-role.ts's comment for why).
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# RLS-restricted role used by packages/api's tRPC context (see packages/db/scripts/setup-rls-role.ts
# and packages/db/sql/rls-policies.sql) — NOT the same credentials as DATABASE_URL above. Generated
# automatically by setup-rls-role.ts, which prints a ready-to-use value for this.
DATABASE_URL_RLS="postgresql://rebound_app.[YOUR-PROJECT-REF]:[ROLE-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"
